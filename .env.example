# =========================================================================
# TYN × PROATHLETIC E-COMMERCE ENVIRONMENT CONFIGURATION
# =========================================================================

# Supabase Database & Auth (Project URL and Anon Key from Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Service Role Key (for secure backend migrations or admin scripts, never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Payment Gateway Credentials
# Kaspi Pay Merchant ID
KASPI_PAY_MERCHANT_ID=
KASPI_PAY_SECRET_KEY=

# Optional: Stripe (for international card processing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
